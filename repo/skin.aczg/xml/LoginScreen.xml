<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol always="true">52</defaultcontrol>
	
	
	<!-- Reset Exit Screen -->
	<onload>CancelAlarm(ShutdownInProgressCancelIfNotWorking,true)</onload>
	<onload>ClearProperty(ShutdownInProgressText,home)</onload>
	
	<!-- Reset Startup Screen -->
	<onload>SetProperty(ExperimentalStartScreenDone,,home)</onload>
	<onload>SetProperty(ExperimentalStartScreenDoneDelayed,,home)</onload>
	<onload>CancelAlarm(ExperimentalStartScreenAlarm1,true)</onload>
	<onload>CancelAlarm(ExperimentalStartScreenAlarm2,true)</onload>
	<onload>CancelAlarm(ExperimentalStartScreenAlarm3,true)</onload>
	
	<!-- Reset New Version Screen -->
	<onload>CancelAlarm(WelcomeNewVersion,true)</onload>
	
	
	<animation effect="fade" time="2000">WindowOpen</animation>
	<animation effect="fade" time="750">WindowClose</animation>
	
	<controls><!-- WRAPPER START --><control type="group"><centerleft>50%</centerleft><centertop>50%</centertop><width>1920</width><height>1080</height><!-- WRAPPER START -->
		
		<control type="group">
			
			<include>ContentPanelBackgrounds</include>
			
			
			<control type="group">
				<top>60</top>
				
				<animation effect="slide" start="0,0" end="0,180" time="0" condition="Integer.IsEqual(Container(52).NumItems,1)">Conditional</animation>
				<animation effect="slide" start="0,0" end="0,135" time="0" condition="Integer.IsEqual(Container(52).NumItems,2)">Conditional</animation>
				<animation effect="slide" start="0,0" end="0,90" time="0" condition="Integer.IsEqual(Container(52).NumItems,3)">Conditional</animation>
				
				<control type="list" id="52">
					<left>570</left>
					<top>230</top>
					<width>780</width>
					<height>602</height>
					<onleft>noop</onleft>
					<onup>20</onup>
					<onright>60</onright>
					<ondown>noop</ondown>
					<viewtype label="535">list</viewtype>
					<pagecontrol>60</pagecontrol>
					<include>StandardScrollTime</include>
					<itemlayout height="150" width="780">
						<control type="image">
							<left>19</left>
							<top>15</top>
							<width>113</width>
							<height>113</height>
							<texture fallback="DefaultUser.png" diffuse="colors/diffuse/113x113.png">$INFO[ListItem.Icon]</texture>
							<aspectratio scalediffuse="false">scale</aspectratio>
							<animation effect="fade" end="95" time="0" condition="true">Conditional</animation>
						</control>
						<control type="label">
							<left>165</left>
							<top>42</top>
							<width>570</width>
							<height>141</height>
							<font>Light29</font>
							<textcolor>grey2</textcolor>
							<selectedcolor>selected</selectedcolor>
							<label>$INFO[ListItem.Label]</label>
							<scroll>false</scroll>
						</control>
					</itemlayout>
					<focusedlayout height="150" width="780">
						<control type="image">
							<left>0</left>
							<top>0</top>
							<width>780</width>
							<height>143</height>
							<texture border="14">button-focus.png</texture>
							<visible>Control.HasFocus(52)</visible>
							<include>VisibleFadeEffect</include>
							<include>FocusAnimationTypeSimple1Slower</include>
						</control>
						<control type="image">
							<left>19</left>
							<top>15</top>
							<width>113</width>
							<height>113</height>
							<texture fallback="DefaultUser.png" diffuse="colors/diffuse/113x113.png">$INFO[ListItem.Icon]</texture>
							<aspectratio scalediffuse="false">scale</aspectratio>
							<animation effect="fade" start="100" end="95" time="0" condition="!Control.HasFocus(52)">Conditional</animation>
						</control>
						<control type="group">
							<control type="label">
								<left>165</left>
								<top>42</top>
								<width>570</width>
								<height>141</height>
								<font>Light29</font>
								<textcolor>grey2</textcolor>
								<selectedcolor>selected</selectedcolor>
								<label>$INFO[ListItem.Label]</label>
								<scroll>false</scroll>
							</control>
							<visible>!Control.HasFocus(52)</visible>
						</control>
						<control type="group">
							<control type="label">
								<left>165</left>
								<top>42</top>
								<width>570</width>
								<height>141</height>
								<font>Light29</font>
								<textcolor>white</textcolor>
								<selectedcolor>selected</selectedcolor>
								<label>$INFO[ListItem.Label]</label>
								<scroll>false</scroll>
							</control>
							<visible>Control.HasFocus(52)</visible>
						</control>
					</focusedlayout>
				</control>
				<control type="scrollbar" id="60">
					<left>1380</left>
					<top>230</top>
					<include>scrollBarStyleDefaultWidth</include>
					<height>593</height>
					<onleft>52</onleft>
					<onup>noop</onup>
					<onright>noop</onright>
					<ondown>noop</ondown>
					<showonepage>false</showonepage>
					<include content="scrollBarStyleDefault">
						<param name="colordiffuse" value="$VAR[accentColorDiffuseRegular]" />
					</include>
				</control>
			</control>
			
			
			
			
			
			
			<control type="group">
				<left>924</left>
				<top>25</top>
				<control type="button" id="20">
					<description>Power push button</description>
					<left>0</left>
					<top>0</top>
					<width>69</width>
					<height>69</height>
					<label></label>
					<font></font>
					<onclick>ActivateWindow(ShutdownMenu)</onclick>
					<texturefocus></texturefocus>
					<texturenofocus></texturenofocus>
					<onleft>noop</onleft>
					<onright>noop</onright>
					<onup>noop</onup>
					<ondown>52</ondown>
				</control>
				<control type="image" id="20">
					<left>0</left>
					<top>0</top>
					<width>69</width>
					<height>69</height>
					<texture colordiffuse="$VAR[accentColorDiffuseRegular]">osd/buttons/_FO-neutral.png</texture>
					<visible>Control.HasFocus(20)</visible>
					<include>VisibleFadeEffectSlower2</include>
				</control>
				<control type="image">
					<description>Power Icon</description>
					<left>11</left>
					<top>13</top>
					<width>47</width>
					<height>47</height>
					<aspectratio>keep</aspectratio>
					<texture>icon_power-large.png</texture>
					<animation effect="fade" start="100" end="55" time="500" condition="!Control.HasFocus(20)">Conditional</animation>
				</control>
			</control>
			
			
		</control>
		
	<include condition="Skin.HasSetting(EnableDebugOverlaySkinAndVars)">DebugOverlaySkinAndVars</include><include condition="Skin.HasSetting(EnableDebugOverlaySystemLoad)">DebugOverlaySystemLoad</include><!-- WRAPPER STOP --></control><!-- WRAPPER STOP --></controls>
</window>
