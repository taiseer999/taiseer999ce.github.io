				<control type="image">
					<include>SeekBarLeftPieceDimensions</include>
					<texture colordiffuse="30FFFFFF">osd/progress/progress-9px-start-end.png</texture>
				</control>
				<!-- [Very-transparent]   end piece -->
				<control type="image">
					<include>SeekBarEndPieceDimensions</include>
					<texture colordiffuse="30FFFFFF" flipx="true">osd/progress/progress-9px-start-end.png</texture>
				</control>
				<!-- [Full-white]   left piece -->
				<control type="image">
					<include>SeekBarLeftPieceDimensions</include>
					<texture colordiffuse="EBFFFFFF">osd/progress/progress-9px-start-end.png</texture>
					<visible>![VideoPlayer.Content(LiveTV) + !VideoPlayer.HasEpg]</visible>
				</control>
				<!-- [Full-white]   end piece -->
				<control type="image">
					<include>SeekBarEndPieceDimensions</include>
					<texture colordiffuse="EBFFFFFF" flipx="true">osd/progress/progress-9px-start-end.png</texture>
					<visible>!VideoPlayer.Content(LiveTV) + Integer.IsGreaterOrEqual(Player.Progress,100) + Integer.IsLessOrEqual(Player.TimeRemaining(hh),00) + Integer.IsLessOrEqual(Player.TimeRemaining(mm),00) + Integer.IsLessOrEqual(Player.TimeRemaining(ss),02)</visible>
					<visible>String.IsEqual(Window(10000).Property(CH.Player.Progress),100.0)</visible>
				</control>
				
				
				
				<!-- [No-base] [Medium-transparent-fill]   Progress Bar Cache -->
				<control type="progress">
					<description>ProgressbarCache</description>
					<include>SeekBarMiddlePartDimensions</include>
					<info>Player.ProgressCache</info>
					
					<visible>!VideoPlayer.Content(LiveTV)</visible>
					
					<include>progressBarStyleSeekBarCache</include>
					
				</control>
				<!-- [No-base] [Medium-transparent-fill]   Progress Bar Cache: End piece (Player.ProgressCache == 100) -->
				<control type="image">
					<include>SeekBarEndPieceDimensions</include>
					<texture colordiffuse="25FFFFFF" flipx="true">osd/progress/progress-9px-start-end.png</texture>
					<visible>!VideoPlayer.Content(LiveTV) + Integer.IsGreaterOrEqual(Player.ProgressCache,100)</visible>
				</control>
				
				
				
				<!-- [No-base] [Medium-transparent-fill]   (Kodi 18+) Progress Bar LiveTV TimeShift Cache -->
				<control type="progress">
					<description>ProgressbarTimeshift</description>
					<include>SeekBarMiddlePartDimensions</include>
					<info>PVR.TimeshiftProgressBufferEnd</info>
					
					<visible>PVR.IsTimeShift</visible>
					
					<include>progressBarStyleSeekBarCache</include>
					
				</control>
				<!--dev-bc-->
				
				
				
				
				
				<!-- [Very-transparent-base] [Full-white-fill]   (Kodi 17+) Progress Bar LiveTV + HasEPG -->
				<control type="progress">
					<description>Progressbar</description>
					<include>SeekBarMiddlePartDimensions</include>
					<info>PVR.EpgEventProgress</info><!-- Kodi 18+ changes -->
					<visible>[VideoPlayer.Content(LiveTV) + VideoPlayer.HasEpg]</visible>
					<include>progressBarStyleSeekBar</include>
				</control>
				<!--dev-bc-->
				
				
				
				<!--dev-bc-->
				<!-- [Very-transparent-base] [Full-white-fill]   Progress Bar non-LiveTV -->
				<control type="group">
					<visible>!VideoPlayer.Content(LiveTV)</visible>
					
					<control type="image">
						<include>SeekBarMiddlePartDimensions</include>
						<texture colordiffuse="30FFFFFF">osd/progress/progress-mid-2px.png</texture>
					</control>
					<control type="image">
						<include>SeekBarMiddlePartDimensions</include>
						<texture colordiffuse="EBFFFFFF">osd/progress/progress-mid-2px.png</texture>
						<include>PlayerProgressScalingCH</include>
						<visible>Integer.IsGreaterOrEqual(Player.Progress,0) + !String.IsEmpty(Window(10000).Property(CH.Player.Progress))</visible>
						<visible>![ Integer.IsEqual(Player.Progress,0) + [String.StartsWith(Window(10000).Property(CH.Player.Progress),99.) | String.StartsWith(Window(10000).Property(CH.Player.Progress),100.)] ]</visible>
					</control>
					
				</control>
				
				
				
				
				
				
				<!-- Seek Slider Kodi 18+ LiveTV seek-->
				<include condition="!String.StartsWith(System.BuildVersion,17.) + String.StartsWith(System.BuildVersion,18.)">PVR_SeekSlider_Kodi_18</include>
				
				<!-- Seek Slider Kodi 19+ LiveTV seek-->
				<include condition="!String.StartsWith(System.BuildVersion,17.) + !String.StartsWith(System.BuildVersion,18.)">PVR_SeekSlider_Kodi_19+</include>
				
				
				
				<!-- Seek Slider -->
				<control type="slider"><info>Player.SeekBar</info><!-- formely id="401" -->
					<description>Seek Slider</description>
					<left>149</left>
					<top>10</top>
					<width>1424</width>
					<height>48</height>
					
					<texturesliderbar>osd/progress/seek_bg.png</texturesliderbar>
					<textureslidernib colordiffuse="$VAR[uiColorVariantSliderNibFocus]">osd/progress/seek_marker-neutral.png</textureslidernib>
					<textureslidernibfocus colordiffuse="$VAR[uiColorVariantSliderNibFocus]">osd/progress/seek_marker-neutral.png</textureslidernibfocus>
					
					<!-- Workaround: Reduce visual occurence of very short post seek slider jump (Kodi issue) -->
					<visible>!String.IsEmpty(Player.SeekTime) + !String.IsEqual(Player.SeekTime,Player.Time)</visible>
					
					<visible>![VideoPlayer.Content(LiveTV) + VideoPlayer.HasEpg]</visible>
					<!-- Kodi 18+ changes -->
					
					<visible>Player.Seeking + !String.IsEmpty(Player.SeekStepSize)</visible>
					
					<animation effect="slide" start="0,0" end="-3,0" time="0" condition="!String.IsEmpty(Player.SeekStepSize) + String.StartsWith(Player.SeekStepSize,-)" reversible="false">Conditional</animation>
					<animation effect="slide" start="0,0" end="3,0" time="0" condition="!String.IsEmpty(Player.SeekStepSize) + !String.StartsWith(Player.SeekStepSize,-)" reversible="false">Conditional</animation>
					
				</control>
				
				
				
				
				
				
			</control>
			
			
			
		</control>
		
		
		
	<include condition="Skin.HasSetting(EnableDebugOverlaySkinAndVars)">DebugOverlaySkinAndVars</include><include condition="Skin.HasSetting(EnableDebugOverlaySystemLoad)">DebugOverlaySystemLoad</include><!-- WRAPPER STOP --></control><!-- WRAPPER STOP --></controls>
</window>
