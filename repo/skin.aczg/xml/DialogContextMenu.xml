<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol>996</defaultcontrol>
	<include>dialogeffect</include>
	
	<controls>
		
		<control type="group">
			
			
			
			<!-- content menu y-position corrections for Home screen (common in skins in general) -->
			<animation effect="slide" end="0,206" time="0" condition="Window.IsActive(Home) + [String.IsEqual(Skin.String(HomeScreenStyle),0) | String.IsEmpty(Skin.String(HomeScreenStyle))]">Conditional</animation>
			<animation effect="slide" end="0,-66" time="0" condition="Window.IsActive(Home) + String.IsEqual(Skin.String(HomeScreenStyle),1)">Conditional</animation>
			<animation effect="slide" end="0,28" time="0" condition="Window.IsActive(Home) + String.IsEqual(Skin.String(HomeScreenStyle),2)">Conditional</animation>
			
			
			
			<animation effect="slide" end="0,110" time="0" condition="String.IsEqual(Container.ViewMode,Seasons)">Conditional</animation>
			
			
			
			
			<animation effect="slide" end="0,38" time="0" condition="Integer.IsGreaterOrEqual(Container(996).NumItems,15) ">Conditional</animation>
			
			
			
			
			<control type="image" id="999">
				<description>background image</description>
				<left>-51</left>
				<top>-53</top>
				<width>552</width>
				<height>1111</height>
				<texture border="54">DialogBack-rounded.png</texture>
			</control>
			<control type="grouplist" id="996">
				<description>grouplist for context buttons</description>
				<itemgap>3</itemgap>
				
				<left>0</left>
				<top>0</top>
				<width>450</width>
				<height max="1005">auto</height>
			</control>
			
			
			
		</control>
		
		<control type="button" id="1000">
			<description>button template</description>
			<width>450</width>
			<height>63</height>
			<font>fontContextMenu</font>
			<align>left</align>
			<textcolor>grey2</textcolor>
			<focusedcolor>white</focusedcolor>
			<texturenofocus></texturenofocus>
			<texturefocus border="14" colordiffuse="$VAR[accentColorDiffuseForNeutralTextures]">button-focus-neutral.png</texturefocus>
			<textoffsetx>20</textoffsetx>
		</control>
		
	</controls>
</window>
