						<left>1597</left>
						<top>208</top>
						<width>54</width>
						<height>54</height>
						<animation effect="fade" end="85" time="0" condition="true">Conditional</animation>
						<control type="image" id="1">
							<description>Stinger icon</description>
							<left>0</left>
							<width>54</width>
							<height>54</height>
							<texture>_added_img/stinger_scene.png</texture>
