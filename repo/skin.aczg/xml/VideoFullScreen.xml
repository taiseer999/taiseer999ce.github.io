							<animation effect="fade" end="100" time="750">Visible</animation>
							<animation effect="fade" end="0" time="750">Hidden</animation>
						</control>
					</control>
					
					<!-- END TIME ICON -->
					<control type="group" id="1">
						<top>15</top>
						<control type="label" id="1">
							<top>291</top>
							<right>102</right>
							<width>1000</width>
							<height>54</height>
							<label>$INFO[Player.FinishTime]</label>
							<align>right</align>
							<aligny>center</aligny>
							<font>Light17</font>
							<textcolor>white</textcolor>
							<scroll>false</scroll>
							<animation effect="fade" end="60" time="0" condition="true">Conditional</animation>
						</control>
						<control type="image" id="1">
							<top>260</top>
							<left>149r</left>
							<width>48</width>
							<height>48</height>
							<aspectratio align="right">keep</aspectratio>
							<texture>end_time_icon$VAR[isUhdScreenStringSuffix].png</texture>
							<animation effect="fade" end="60" time="0" condition="true">Conditional</animation>
