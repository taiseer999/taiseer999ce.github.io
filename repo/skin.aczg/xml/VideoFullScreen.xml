<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol></defaultcontrol>
	
	<onload condition="!String.IsEmpty(Window(Home).Property(OSDinfodialogButtonActive))">ClearProperty(OSDinfodialogButtonActive,home)</onload>
	<onload condition="!String.IsEmpty(Player.Art(poster))">SetProperty(PlayerArtPosterTemp,"$INFO[Player.Art(poster)]",home)</onload>
	
	<!--
	<onload condition="!String.IsEmpty(Window(Home).Property(StreamSelector_Show))">ClearProperty(StreamSelector_Show,home)</onload>
	<onunload condition="!String.IsEmpty(Window(Home).Property(StreamSelector_Show))">ClearProperty(StreamSelector_Show,home)</onunload>
	-->
	
	
	<!-- Internal note: EVERY element has to have an id="1" attribute to be visible and working -->
	
	
	
	<controls><!-- WRAPPER START --><control type="group" id="1"><centerleft>50%</centerleft><centertop>50%</centertop><width>1920</width><height>1080</height><!-- WRAPPER START -->
		
		<control type="group" id="1">
		<visible>!Player.HasGame</visible>
		
		<control type="group" id="1">
			
			<!-- FADEOUT TOP -->
			<!-- Has to be separate from FADEOUT BOTTOM because seek numberic can be activated without everything else -->
			<control type="group" id="1">
				<control type="image" id="1">
					
					<!-- SkinOutOfBounds -->
					<include condition="Integer.IsLess(Window(Home).Property(CinemaHelper.GetSettingValue.lookandfeel.skinzoom),0) | !String.IsEqual(Skin.AspectRatio,16:9)">SkinOutOfBoundsBgDimensionsVideoFullScreen</include>
					
					<left>0</left>
					<top>-150</top>
					<width>1920</width>
					<height>270</height>
					
					<texture flipy="true" border="1">osd/shadow_gradient_osd-bg.png</texture>
					<animation effect="fade" end="60" time="0" condition="true">Conditional</animation>
				</control>
				
				<visible>[!String.IsEmpty(Player.SeekNumeric) | Window.IsActive(VideoOSD)] + !Window.IsVisible(SliderDialog) + !Window.IsVisible(FullscreenGame)</visible>
				<animation effect="fade" end="100" time="700">Visible</animation>
				<animation effect="fade" end="0" time="300">Hidden</animation>
			</control>
			
			
			
			<control type="group" id="1">
				<visible>!VideoPlayer.Content(LiveTV) + !Window.IsActive(VideoOSD) + Window.IsVisible(SeekBar)</visible>
				
				<animation effect="fade" end="100" time="500">Visible</animation>
				<animation effect="fade" end="0" time="500">Hidden</animation>
				
				<!-- SEEKBAR SHADOW -->
				<control type="image" id="1">
					<left>0</left>
					<top>231r</top>
					<width>1920</width>
					<height>150</height>
					<texture>osd/shadow_seekbar-bg.png</texture>
					<animation effect="fade" end="30" time="0" condition="true">Conditional</animation>
				</control>
				
			</control>
			
			<control type="group" id="1">
				<visible>[Window.IsActive(VideoOSD) | [VideoPlayer.Content(LiveTV) + [Window.IsVisible(SeekBar) | Player.ShowInfo]] ] 
									+ !Window.IsVisible(SliderDialog)
									
									+ [[String.IsEmpty(Window(Home).Property(PlayBackJustStarted)) + String.IsEmpty(Window(Home).Property(PlayBackJustEnded))] | VideoPlayer.Content(LiveTV) | Window.IsActive(VideoOSD)]
									
									</visible>
				
				<animation effect="fade" end="100" time="700">Visible</animation>
				<animation effect="fade" end="0" time="300">Hidden</animation>
				
				<!-- FADEOUT BOTTOM -->
				<control type="image" id="1">
					
					<!-- SkinOutOfBounds -->
					<include condition="Integer.IsLess(Window(Home).Property(CinemaHelper.GetSettingValue.lookandfeel.skinzoom),0) | !String.IsEqual(Skin.AspectRatio,16:9)">SkinOutOfBoundsBgDimensionsVideoFullScreen</include>
					
					<left>0</left>
					<top>387r</top>
					<width>1920</width>
					<height>390</height>
					
					<texture border="1">osd/shadow_gradient_osd-bg.png</texture>
					<animation effect="fade" end="90" time="0" condition="true">Conditional</animation>
				</control>
				
				<!-- SkinOutOfBounds -->
				<!-- Extend y-mirrored bottom fade out only for 19:10 Skin AR -->
				<include condition="String.IsEqual(Skin.AspectRatio,16:10)">SkinOutOfBoundsBgDimensionsVideoFullScreenBottomGradientExtendFor16by10</include>
				
				
				
			</control>
			
			
			
			<control type="group" id="1">
				<depth>DepthOSD</depth>
				
				<visible>!Window.IsVisible(FullscreenGame) + [Window.IsVisible(SeekBar) | Player.ShowInfo | Window.IsActive(VideoOSD)] 
									+ !Window.IsVisible(SliderDialog)
									
									+ [[String.IsEmpty(Window(Home).Property(PlayBackJustStarted)) + String.IsEmpty(Window(Home).Property(PlayBackJustEnded))] | VideoPlayer.Content(LiveTV) | Window.IsActive(VideoOSD)]
									
									</visible>
				
				<animation effect="fade" end="100" time="700">Visible</animation>
				<animation effect="fade" end="0" time="300">Hidden</animation>
				
				<!-- PLAYLIST STATUS -->
				<control type="group" id="1">
					<left>19</left>
					<control type="group" id="1">
						<control type="group" id="1">
							<control type="image" id="1">
								<left>0</left>
								<top>15</top>
								<width>30</width>
								<height>30</height>
								<texture>_added_img/playlist_icon_large.png</texture>
								<aspectratio>keep</aspectratio>
							</control>
							<control type="label" id="1">
								<left>42</left>
								<top>10</top>
								<width>1500</width>
								<height>39</height>
								<align>left</align>
								<aligny>center</aligny>
								<font>Light20</font>
								<textcolor>white</textcolor>
								<label>$INFO[Playlist.Position(video)]$INFO[Playlist.Length(video),/]</label>
							</control>
							<visible>Integer.IsGreater(Playlist.Length(video),1) + Integer.IsGreater(Playlist.Position(video),0) + !VideoPlayer.Content(LiveTV)</visible>
						</control>
						<visible>Window.IsActive(VideoOSD)</visible>
						<include>FullScreenInfoVisibleAnimations</include>
					</control>
				</control>
				
				<include>FullScreenClock</include>
				
				<!-- POSTER / IMAGE / ICON -->
				
				<!-- Episodes -->
				<!-- Episode + poster -->
				<control type="image" id="1">
					<depth>DepthOSDPopout</depth>
					<description>cover image</description>
					<left>245</left>
					<top>470r</top>
					<width>114</width>
					<height>171</height>
					<texture diffuse="colors/diffuse/114x171-rounded.png">$VAR[TvShowEpisodeOrMoviePlayerPoster]</texture>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<visible>VideoPlayer.Content(Episodes) 
									+ [!String.IsEmpty(Player.Art(season.poster)) | !String.IsEmpty(Player.Art(tvshow.poster))] 
									+ ![VideoPlayer.Content(Movies) | VideoPlayer.Content(LiveTV)] + Window.IsVisible(VideoOSD) + !Skin.HasSetting(ReducedFullScreenInfoOSDArtworkDisable)</visible>
					<include>FullScreenInfoVisibleAnimations</include>
				</control>
				
				<!-- Videos -->
				<!-- Video (! Only show for PVR Recordings (informational purpose), otherwise show no video thumbnail to avoid bad visuals -->
				<control type="image" id="1">
					<depth>DepthOSDPopout</depth>
					<left>245</left>
					<top>480r</top>
					<width>180</width>
					<height>180</height>
					<texture border="10" colordiffuse="FF1a1a1a">colors/white_border10.png</texture>
					<visible>PVR.IsPlayingRecording + [
										!VideoPlayer.Content(Episodes) 
										| [VideoPlayer.Content(Episodes) + String.IsEmpty(Player.Art(season.poster)) 
											+ String.IsEmpty(Player.Art(tvshow.poster))] 
										]
										+ ![VideoPlayer.Content(Movies) | VideoPlayer.Content(LiveTV)] + Window.IsVisible(VideoOSD)</visible>
					<include>FullScreenInfoVisibleAnimations50</include>
				</control>
				<control type="image" id="1">
					<depth>DepthOSDPopout</depth>
					<description>cover image</description>
					<left>254</left>
					<top>471r</top>
					<width>162</width>
					<height>162</height>
					<texture fallback="DefaultPVRChannels.png">$INFO[Player.Art(icon)]</texture>
					<aspectratio align="center" aligny="center">keep</aspectratio>
					<visible>PVR.IsPlayingRecording + [
										!VideoPlayer.Content(Episodes) 
										| [VideoPlayer.Content(Episodes) + String.IsEmpty(Player.Art(season.poster)) 
											+ String.IsEmpty(Player.Art(tvshow.poster))] 
										]
										+ ![VideoPlayer.Content(Movies) | VideoPlayer.Content(LiveTV)] + Window.IsVisible(VideoOSD)</visible>
					<include>FullScreenInfoVisibleAnimations</include>
				</control>
				
				<!-- movie + poster -->
				<control type="image" id="1">
					<depth>DepthOSDPopout</depth>
					<description>Movie cover image</description>
					<left>245</left>
					<top>430r</top>
					<width>114</width>
					<height>171</height>
					<texture diffuse="colors/diffuse/114x171-rounded.png">$INFO[Player.Art(poster)]</texture>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<visible>VideoPlayer.Content(Movies) + !String.IsEmpty(Player.Art(poster)) + Window.IsVisible(VideoOSD) + !Skin.HasSetting(ReducedFullScreenInfoOSDArtworkDisable)</visible>
					<include>FullScreenInfoVisibleAnimations</include>
				</control>
				
				<!-- Music Videos -->
				<control type="image" id="1">
					<depth>DepthOSDPopout</depth>
					<left>245</left>
					<top>480r</top>
					<width>180</width>
					<height>180</height>
					<texture fallback="DefaultAlbumCover.png" diffuse="colors/diffuse/180x180-rounded.png">$VAR[PlayerArtThumbMusicVideo]</texture>
					<aspectratio scalediffuse="false">scale</aspectratio>
					<fadetime>100</fadetime>
					<visible>VideoPlayer.Content(MusicVideos) + !String.IsEmpty(Player.Art(thumb)) + Window.IsVisible(VideoOSD) + !Skin.HasSetting(ReducedFullScreenInfoOSDArtworkDisable)</visible>
					<include>FullScreenInfoVisibleAnimations</include>
				</control>
				
				<!-- LiveTV icon -->
				<control type="image" id="1">
					<depth>DepthOSDPopout</depth>
					<left>245</left>
					<top>480r</top>
					<width>180</width>
					<height>180</height>
					<texture border="10" colordiffuse="FF1a1a1a">colors/white_border10.png</texture>
					<visible>VideoPlayer.Content(LiveTV)</visible>
					<animation effect="fade" end="50" time="0" condition="true">Conditional</animation>
				</control>
				<control type="image" id="1">
					<depth>DepthOSDPopout</depth>
					<description>Picon image</description>
					<left>254</left>
					<top>471r</top>
					<width>162</width>
					<height>162</height>
					<texture fallback="DefaultPVRChannels.png">$INFO[Player.Art(thumb)]</texture>
					<aspectratio align="center" aligny="center">keep</aspectratio>
					<visible>VideoPlayer.Content(LiveTV)</visible>
					<fadetime>100</fadetime>
				</control>
				
				
				
				<!-- AUDIO CODEC -->
				<control type="group" id="1">
					<left>100</left>
					<top>104r</top>
					<width>114</width>
					<height>54</height>
					<control type="image" id="1">
						<description>Audio Codec Image</description>
						<width>114</width>
						<height>54</height>
						<aspectratio align="center">keep</aspectratio>
						<texture>$INFO[VideoPlayer.AudioCodec,flagging/audio/codecs/,.png]</texture>
						<include>FullScreenInfoFlaggingTransparencyText</include>
						<fadetime>150</fadetime>
					</control>
					<visible>!String.IsEmpty(VideoPlayer.AudioCodec) + Skin.HasSetting(ReducedFullScreenInfoOSDAudioCodec) + Window.IsActive(VideoOSD) + !Player.ChannelPreviewActive</visible>
					<animation effect="fade" end="100" time="0" condition="true">Conditional</animation>
					<include>VisibleFadeEffect</include>
				</control>
				
				
				
				<!-- VIDEO RESOLUTION -->
				<control type="group" id="1">
					<left>100</left>
					<top>243r</top>
					<width>114</width>
					<height>54</height>
					<control type="image" id="1">
						<width>114</width>
						<height>54</height>
						<texture border="6" colordiffuse="ffFFFFFF">flagging/blank.png</texture>
						<include>FullScreenInfoFlaggingTransparencyBackground</include>
					</control>
					<control type="image" id="1">
						<left>21</left>
						<description>Video Resolution Image</description>
						<width>72</width>
						<height>54</height>
						<texture fallback="flagging/video/resolutions/_fallback.png">flagging/video/resolutions/$VAR[isUhdScreenStringFolder]$INFO[VideoPlayer.VideoResolution].png</texture>
						<include>FullScreenInfoFlaggingTransparencyText</include>
					</control>
					<visible>Skin.HasSetting(ReducedFullScreenInfoOSDVideoResolution) + Window.IsVisible(VideoOSD) + !Player.ChannelPreviewActive + !String.IsEmpty(VideoPlayer.VideoResolution)</visible>
					<include>FullScreenInfoFlaggingTransparencyGlobal</include>
					<include>FullScreenInfoVisibleAnimationsNoFadeOut</include>
				</control>
				
				
				
				<control type="group" id="1">
					<left>245</left>
					<top>393r</top>
					
					<!-- NOW RECORDING ICON for LiveTV -->
					<control type="image" id="1">
						<top>62</top>
						<left>4</left>
						<width>28</width>
						<height>28</height>
						<aspectratio align="center" aligny="center">keep</aspectratio>
						<texture>PVR-IsRecording.png</texture>
						<visible>VideoPlayer.Content(LiveTV) + PVR.IsRecordingPlayingChannel + !Player.ChannelPreviewActive</visible>
						<animation effect="fade" start="0" end="100" time="3000" pulse="true" reversible="true" condition="true" tween="sine" easing="out">Conditional</animation>
					</control>
					
					<!-- TV show Title + S01E01  -->
					<control type="label" id="1">
						<description>TV Show label</description>
						<left>3</left>
						<top>114</top>
						<width>1200</width>
						<height>38</height>
						<align>left</align>
						<font>Light17</font>
						<label>$INFO[VideoPlayer.TVShowTitle][COLOR=grey2]$INFO[VideoPlayer.Season,   S,]$INFO[VideoPlayer.Episode, E,][/COLOR]</label>
						<textcolor>grey</textcolor>
						<visible>Window.IsVisible(VideoOSD) + [VideoPlayer.Content(Episodes) + !String.IsEmpty(VideoPlayer.TVShowTitle)]</visible>
						<include>FullScreenInfoVisibleAnimations</include>
					</control>
					<!-- Music Album Title + Year -->
					<control type="label" id="1">
						<description>Music Info label</description>
						<left>3</left>
						<top>114</top>
						<width>1200</width>
						<height>38</height>
						<align>left</align>
						<font>Light17</font>
						<label>$INFO[VideoPlayer.Artist]$INFO[VideoPlayer.Album, – ]$INFO[VideoPlayer.Year, (,)]</label>
						<textcolor>grey</textcolor>
						<visible>Window.IsVisible(VideoOSD) + VideoPlayer.Content(MusicVideos)</visible>
						<include>FullScreenInfoVisibleAnimations</include>
					</control>
					<!-- LiveTV Channel Number + Name -->
					<control type="label" id="1">
						<description>LiveTV Info label</description>
						<left>3</left>
						<top>114</top>
						<width>1200</width>
						<height>38</height>
						<align>left</align>
						<font>Light17</font>
						<label>$VAR[VideoFullScreenSubLabel]</label>
						<textcolor>grey</textcolor>
						<visible>VideoPlayer.Content(LiveTV) | [PVR.IsPlayingRecording + Window.IsVisible(VideoOSD)]</visible>
					</control>
					
					<!-- TITLE: Large main title for Fullscreen-->
					<control type="label" id="1">
						<left>3</left>
						<top>153</top>
						<include>FullScreenInfoTitleWidthReduced</include>
						<!-- also includes visible animation -->
						<height>45</height>
						<font>Light30</font>
						<align>left</align>
						<aligny>center</aligny>
						<label>$VAR[VideoFullScreenTitle]</label>
						<textcolor>white</textcolor>
						<scroll>false</scroll>
						<visible>VideoPlayer.Content(LiveTV) | [PVR.IsPlayingRecording + Window.IsVisible(VideoOSD)] | Window.IsVisible(VideoOSD)</visible>
					</control>
					
					<!-- OPTIONAL Fullscreen OSD FLAGS: audio/sub language, audio channels -->
					<control type="grouplist" id="1">
						<left>485r</left>
						<top>243r</top>
						<width>1080</width>
						<height>54</height>
						<itemgap>0</itemgap>
						<orientation>horizontal</orientation>
						
						<!--   DEV INFO: "String.IsEqual(Control.GetLabel(12345),)"   is a substitute for   "String.IsEmpty(VideoPlayer.AudioLanguage)"   -->
						
						<animation effect="slide" start="0,0" end="126,0" time="0" condition="!Skin.HasSetting(ReducedFullScreenInfoOSDAudioSubLanguage) | String.IsEmpty(VideoPlayer.SubtitlesLanguage) | String.IsEqual(Control.GetLabel(12345),) | !VideoPlayer.SubtitlesEnabled">Conditional</animation>
						<!-- if no audio track + no subs -->
						<animation effect="slide" start="0,0" end="126,0" time="0" condition="!Skin.HasSetting(ReducedFullScreenInfoOSDAudioSubLanguage) | [String.IsEmpty(VideoPlayer.SubtitlesLanguage) | !VideoPlayer.SubtitlesEnabled] + String.IsEqual(Control.GetLabel(12345),)">Conditional</animation>
						<animation effect="slide" start="0,0" end="-84,0" time="0" condition="Skin.HasSetting(ReducedFullScreenInfoOSDAudioChannels) + !String.IsEmpty(VideoPlayer.AudioChannels)">Conditional</animation>
						
						<!-- SUBTITLE LANGUAGE -->
						<control type="group" id="1">
							<width>126</width>
							<height>54</height>
							<control type="image" id="1">
								<width>114</width>
								<height>54</height>
								<texture border="6" colordiffuse="f9FFFFFF">flagging/blank.png</texture>
								<include>FullScreenInfoFlaggingTransparencyBackground</include>
							</control>
							<control type="image" id="1">
								<width>114</width>
								<height>54</height>
								<texture>flagging/SubLang.png</texture>
								<include>FullScreenInfoFlaggingTransparencyText</include>
							</control>
							<control type="label" id="1">
								<left>48</left>
								<top>3</top>
								<width>72</width>
								<height>54</height>
								<font>Light20</font>
								<align>left</align>
								<label>[LOWERCASE]$VAR[VideoPlayerSubtitlesLanguage][/LOWERCASE]</label>
								<textcolor>white</textcolor>
								<include>FullScreenInfoFlaggingTransparencyText</include>
							</control>
							<include>FullScreenInfoFlaggingTransparencyGlobal</include>
							
							<visible>![String.IsEmpty(VideoPlayer.SubtitlesLanguage) | Player.ChannelPreviewActive] + VideoPlayer.SubtitlesEnabled + Window.IsVisible(VideoOSD) + Skin.HasSetting(ReducedFullScreenInfoOSDAudioSubLanguage)</visible>
							
							<include>FullScreenInfoVisibleAnimationsNoFadeOut</include>
						</control>
						
						<!-- AUDIO LANGUAGE -->
						<control type="group" id="1">
							<width>126</width>
							<height>54</height>
							<control type="image" id="1">
								<width>114</width>
								<height>54</height>
								<texture border="6" colordiffuse="f9FFFFFF">flagging/blank.png</texture>
								<include>FullScreenInfoFlaggingTransparencyBackground</include>
							</control>
							<control type="image" id="1">
								<description>Audio Language Image</description>
								<width>114</width>
								<height>54</height>
								<texture>flagging/AudioLang.png</texture>
								<include>FullScreenInfoFlaggingTransparencyText</include>
							</control>
							<!-- dummy audio language var -->
							<control type="label" id="12345">
								<label>$VAR[VideoPlayerAudioLanguage]</label>
								<visible>false</visible>
							</control>
							<control type="label" id="1">
								<left>45</left>
								<top>3</top>
								<width>72</width>
								<height>54</height>
								<font>Light20</font>
								<align>left</align>
								<label>[LOWERCASE]$VAR[VideoPlayerAudioLanguage][/LOWERCASE]</label>
								<textcolor>white</textcolor>
								<include>FullScreenInfoFlaggingTransparencyText</include>
							</control>
							<include>FullScreenInfoFlaggingTransparencyGlobal</include>
							
							<visible>![   String.IsEqual(Control.GetLabel(12345),)   | Player.ChannelPreviewActive] + Window.IsVisible(VideoOSD) + Skin.HasSetting(ReducedFullScreenInfoOSDAudioSubLanguage)</visible>
							
							<include>FullScreenInfoVisibleAnimationsNoFadeOut</include>
						</control>
						
						<!-- AUDIO CHANNELS -->
						<control type="group" id="1">
							<width>72</width>
							<height>54</height>
							<control type="image" id="1">
								<width>72</width>
								<height>54</height>
								<texture border="6" colordiffuse="f9FFFFFF">flagging/blank.png</texture>
								<include>FullScreenInfoFlaggingTransparencyBackground</include>
							</control>
							<control type="image" id="1">
								<description>Audio Channels Image</description>
								<width>72</width>
								<height>54</height>
								<texture>$INFO[VideoPlayer.AudioChannels,flagging/audio/channels/,.png]</texture>
								<include>FullScreenInfoFlaggingTransparencyText</include>
							</control>
							<visible>!String.IsEmpty(VideoPlayer.AudioChannels) + Skin.HasSetting(ReducedFullScreenInfoOSDAudioChannels) + Window.IsVisible(VideoOSD) + !Player.ChannelPreviewActive</visible>
							<include>FullScreenInfoFlaggingTransparencyGlobal</include>
							<include>FullScreenInfoVisibleAnimationsNoFadeOut</include>
						</control>
						
					</control>
					
					<!-- STINGER ICON @ show with VideoOSD for last 30 minutes of video -->
