<?xml version="1.0" encoding="UTF-8"?>
<includes>
	
	<include name="TextView">
		<control type="group">
			<visible>Control.IsVisible(901)</visible>
			<include>VisibleFadeEffect</include>
			<control type="panel" id="901">
				
				<visible>String.IsEqual(Container.Content,Directors) | String.IsEqual(Container.Content,Studios) | String.IsEqual(Container.Content,Countries) | String.IsEqual(Container.Content,Years) | String.IsEqual(Container.Content,Tags) | String.IsEqual(Container.Content,Genres) | String.IsEqual(Container.Content,Seasons)</visible>
				
				<left>108</left>
				<top>108</top>
				<width>1635</width>
				<height>861</height>
				
				<onleft condition="!Container.Filtered | [Container.Filtered + !Control.IsVisible(98) + !Control.IsVisible(19)]">2</onleft>
				<onleft condition="Container.Filtered + Control.IsVisible(98)">98</onleft>
				<onleft condition="Container.Filtered + !Control.IsVisible(98) + Control.IsVisible(19)">19</onleft>
				
				<onright>60</onright>
				<onup>901</onup>
				<ondown>901</ondown>
				<viewtype label="Text">list</viewtype>
				<pagecontrol>60</pagecontrol>
				<scrolltime tween="sine" easing="inout">350</scrolltime>
				<preloaditems>1</preloaditems>
				
				<itemlayout width="408" height="123">
					<control type="image">
						<left>10</left>
						<top>10</top>
						<width>385</width>
						<height>100</height>
						
						<texture background="true" colordiffuse="5e000000" border="15">colors/white_border15.png</texture>
					</control>
					<control type="label">
						<left>26</left>
						<top>39</top>
						<width>353</width>
						<height>38</height>
						<font>Regular22.5</font>
						<textcolor>grey2</textcolor>
						<selectedcolor>selected</selectedcolor>
						<align>center</align>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
					</control>
					<control type="image">
						<left>350</left>
						<top>71</top>
						<width>33</width>
						<height>33</height>
						<texture>OverlayWatched.png</texture>
						<aspectratio>keep</aspectratio>
						<visible>Window.IsVisible(Videos) + String.IsEqual(Container.Content,Seasons) + !String.IsEmpty(ListItem.PlayCount)</visible>
						<animation effect="fade" end="15" time="0" condition="true">Conditional</animation>
					</control>
				</itemlayout>
				
				<focusedlayout width="408" height="123">
					<control type="image">
						<left>10</left>
						<top>10</top>
						<width>385</width>
						<height>100</height>
						
						<texture background="true" colordiffuse="5e000000" border="15">colors/white_border15.png</texture>
						<include>itemFocusFadeInAnimationHide</include>
					</control>
					<control type="group">
						<control type="image">
							<left>0</left>
							<top>5</top>
							<width>405</width>
							<height>110</height>
							<texture border="15" colordiffuse="$VAR[accentSlightlyTransparentColorDiffuse]">colors/white_border15.png</texture>
							<include>itemFocusFadeInAnimation</include>
						</control>
						<animation effect="zoom" start="90" end="100" time="750" tween="sine" easing="inout" center="auto">Focus</animation>
						<animation effect="zoom" end="90" start="100" time="500" tween="sine" easing="inout" center="auto">UnFocus</animation>
					</control>
					<control type="label">
						<left>26</left>
						<top>39</top>
						<width>353</width>
						<height>38</height>
						<font>Regular22.5</font>
						<textcolor>grey2</textcolor>
						<selectedcolor>selected</selectedcolor>
						<align>center</align>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
						<include>FocusAnimationType2_Reverse</include>
					</control>
					<control type="label">
						<left>26</left>
						<top>39</top>
						<width>353</width>
						<height>38</height>
						<font>Regular22.5</font>
						<textcolor>white</textcolor>
						<selectedcolor>selected</selectedcolor>
						<align>center</align>
						<aligny>center</aligny>
						<label>$INFO[ListItem.Label]</label>
						<include>FocusAnimationType2</include>
					</control>
					<control type="image">
						<left>350</left>
						<top>71</top>
						<width>33</width>
						<height>33</height>
						<texture>OverlayWatched.png</texture>
						<aspectratio>keep</aspectratio>
						<visible>Window.IsVisible(Videos) + String.IsEqual(Container.Content,Seasons) + !String.IsEmpty(ListItem.PlayCount)</visible>
						<animation effect="fade" end="95" time="0" condition="true">Conditional</animation>
					</control>
				</focusedlayout>
			</control>
			
			
			<control type="scrollbar" id="60">
				<left>1755</left>
				<top>118</top>
				<include>scrollBarStyleDefaultWidth</include>
				<height>838</height>
				<onleft>901</onleft>
				<onright>60</onright>
				<showonepage>false</showonepage>
				<visible>Control.IsVisible(901)</visible>
				<animation effect="fade" end="90" time="0" condition="true">Conditional</animation>
				<include>scrollBarStyleDefault</include>
			</control>
			
		</control>
	</include>
	
</includes>
