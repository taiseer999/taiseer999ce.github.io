<?xml version="1.0" encoding="UTF-8"?>
<window>
	<defaultcontrol></defaultcontrol>
	
	<controls><!-- WRAPPER START --><control type="group"><centerleft>50%</centerleft><centertop>50%</centertop><width>1920</width><height>1080</height><!-- WRAPPER START -->
		
		
		
		<!-- Internal note:  Music Visualization needs to have an id of 2 in this window to be able to lock or change preset -->
		<control type="visualisation" id="2">
			<description>visualisation</description>
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
		</control>
		<control type="image">
			<description>Fanart Image for Artist</description>
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<aspectratio>scale</aspectratio>
			<texture background="true">$VAR[MusicVisualisationFanart]</texture>
			<colordiffuse>AAFFFFFF</colordiffuse>
			<visible>!Skin.HasSetting(HideVisualizationFanart)</visible>
			<fadetime>600</fadetime>
		</control>
		
		
		<!-- FADEOUT TOP -->
		<!-- Has to be separate from FADEOUT BOTTOM because can be activated without everything else -->
		<control type="image">
			<left>0</left>
			<top>-150</top>
			<width>1920</width>
			<height>270</height>
			<texture flipy="true" border="1">osd/shadow_gradient_osd-bg.png</texture>
			<animation effect="fade" end="60" time="0" condition="true">Conditional</animation>
			<visible>Window.IsActive(MusicOSD) + !Window.IsVisible(SliderDialog)</visible>
			<animation effect="fade" end="100" time="700">Visible</animation>
			<animation effect="fade" end="0" time="300">Hidden</animation>
		</control>
		
		<control type="group">
			<depth>DepthOSD</depth>
			
			<visible>[Window.IsVisible(SeekBar) | Player.ShowInfo | Window.IsActive(MusicOSD)] + !Window.IsVisible(SliderDialog)</visible>
			
			<animation effect="fade" end="100" time="700">Visible</animation>
			<animation effect="fade" end="0" time="350">Hidden</animation>
			
			<!-- PARTY MODE LABEL -->
			<control type="label">
				<description>Partymode Header label</description>
				<left>19</left>
				<top>10</top>
				<width>1200</width>
				<height>39</height>
				<align>left</align>
				<aligny>center</aligny>
				<font>Light20</font>
				<textcolor>white</textcolor>
				<label>$LOCALIZE[589]</label>
				<visible>MusicPartyMode.Enabled</visible>
				
				<visible>Window.IsActive(VideoOSD) | Window.IsActive(MusicOSD)</visible>
				<include>FullScreenInfoVisibleAnimations</include>
				
			</control>
			
			<!-- PLAYLIST STATUS -->
			<control type="group">
				<left>19</left>
				<control type="image">
					<left>0</left>
					<top>15</top>
					<width>30</width>
					<height>30</height>
					<texture>_added_img/playlist_icon_large.png</texture>
					<aspectratio>keep</aspectratio>
					<visible>!MusicPartyMode.Enabled + [!String.IsEmpty(MusicPlayer.Playlistposition) | !String.IsEmpty(MusicPlayer.Playlistlength)]</visible>
				</control>
			
				<control type="label">
					<description>Normal Header label</description>
					<left>42</left>
					<top>10</top>
					<width>1200</width>
					<height>39</height>
					<align>left</align>
					<aligny>center</aligny>
					<font>Light20</font>
					<textcolor>white</textcolor>
					<label>$INFO[MusicPlayer.Playlistposition]$INFO[MusicPlayer.Playlistlength,/]</label>
					<visible>!MusicPartyMode.Enabled</visible>
				</control>
				
				<visible>Window.IsActive(VideoOSD) | Window.IsActive(MusicOSD)</visible>
				<include>FullScreenInfoVisibleAnimations</include>
				
			</control>
			
			<include>FullScreenClock</include>
			
			<!-- FADEOUT BOTTOM -->
			<control type="image">
				<left>0</left>
				<top>387r</top>
				<width>1920</width>
				<height>390</height>
				<texture border="1">osd/shadow_gradient_osd-bg.png</texture>
				<animation effect="fade" end="90" time="0" condition="true">Conditional</animation>
			</control>
			
			<!-- cover -->
			<!-- background base -->
			<control type="image">
				<depth>DepthOSDPopout</depth>
				<left>245</left>
				<top>480r</top>
				<width>180</width>
				<height>180</height>
				<texture border="10" colordiffuse="FF1a1a1a">colors/white_border10.png</texture>
				<animation effect="fade" end="50" time="0" condition="true">Conditional</animation>
			</control>
			<!-- Non-LiveTV (music) -->
			<control type="image">
				<depth>DepthOSDPopout</depth>
				<left>245</left>
				<top>480r</top>
				<width>180</width>
				<height>180</height>
				<texture fallback="DefaultAlbumCover.png" diffuse="colors/diffuse/180x180-rounded.png">$INFO[Player.Art(thumb)]</texture>
				<aspectratio scalediffuse="false">scale</aspectratio>
				<visible>![MusicPlayer.Content(LiveTV) | PVR.IsPlayingRecording]</visible>
				<fadetime>100</fadetime>
			</control>
			
			<!-- LiveTV -->
			<control type="image">
				<depth>DepthOSDPopout</depth>
				<left>254</left>
				<top>471r</top>
				<width>162</width>
				<height>162</height>
				<texture fallback="DefaultPVRChannels.png">$INFO[Player.Art(thumb)]</texture>
				<aspectratio align="center" aligny="center">keep</aspectratio>
				<visible>MusicPlayer.Content(LiveTV) | PVR.IsPlayingRecording</visible>
				<fadetime>100</fadetime>
			</control>
			
			
			
			<!-- AUDIO CODEC -->
			<control type="group">
				<left>100</left>
				<top>104r</top>
				<width>114</width>
				<height>54</height>
				<control type="image">
					<description>Audio Codec Image</description>
					<width>114</width>
					<height>54</height>
					<aspectratio align="center">keep</aspectratio>
					<texture>$INFO[MusicPlayer.Codec,flagging/audio/codecs/,.png]</texture>
					<include>FullScreenInfoFlaggingTransparencyText</include>
					<fadetime>150</fadetime>
				</control>
				<visible>!String.IsEmpty(MusicPlayer.Codec) + Skin.HasSetting(ReducedFullScreenInfoOSDAudioCodec) + Window.IsActive(MusicOSD) + !Player.ChannelPreviewActive</visible>
				<animation effect="fade" end="100" time="0" condition="true">Conditional</animation>
				<include>VisibleFadeEffect</include>
			</control>
			
			
			
			<control type="group">
				<left>245</left>
				<top>393r</top>
				
				<!-- NOW RECORDING ICON for LiveTV -->
				<control type="image">
					<top>62</top>
					<left>4</left>
					<width>28</width>
					<height>28</height>
					<aspectratio align="center" aligny="center">keep</aspectratio>
					<texture>PVR-IsRecording.png</texture>
					<visible>VideoPlayer.Content(LiveTV) + PVR.IsRecordingPlayingChannel + !Player.ChannelPreviewActive</visible>
					<animation effect="fade" start="0" end="100" time="3000" pulse="true" reversible="true" condition="true" tween="sine" easing="out">Conditional</animation>
				</control>
				
				<control type="label">
					<description>Sub label</description>
					<left>3</left>
					<top>114</top>
					<width>1200</width>
					<height>38</height>
					<align>left</align>
					<font>Light17</font>
					<label>$VAR[MusicVisualisationSubLabel]</label>
					<textcolor>grey</textcolor>
				</control>
				
				<!-- LARGE TITLE -->
				<control type="label">
					<left>3</left>
					<top>153</top>
					<width>1140</width>
					<height>45</height>
					<font>Light30</font>
					<align>left</align>
					<aligny>center</aligny>
					<label>$VAR[MusicVisualisationTitle]</label>
					<textcolor>white</textcolor>
					<scroll>false</scroll>
				</control>
				
				<control type="grouplist">
					<left>410r</left>
					<top>243r</top>
					<width>1080</width>
					<height>54</height>
					<itemgap>0</itemgap>
					<orientation>horizontal</orientation>
					
					<include>FullScreenMusicRatingGroup</include>
					
				</control>
				
				
				<control type="label">
					<left>262</left>
					<top>253</top>
					<width>900</width>
					<height>39</height>
					<label>$VAR[FullScreenMusicNextTrackArtist]</label>
					<align>center</align>
					<aligny>center</aligny>
					<font>Light17</font>
					<textcolor>grey</textcolor>
					<scroll>false</scroll>
					<visible>MusicPlayer.HasNext + !Window.IsVisible(MusicOSD)</visible>
					<animation effect="fade" time="150">VisibleChange</animation>
				</control>
				
			</control>
			
		</control>
		
	<include condition="Skin.HasSetting(EnableDebugOverlaySkinAndVars)">DebugOverlaySkinAndVars</include><include condition="Skin.HasSetting(EnableDebugOverlaySystemLoad)">DebugOverlaySystemLoad</include><!-- WRAPPER STOP --></control><!-- WRAPPER STOP --></controls>
</window>
