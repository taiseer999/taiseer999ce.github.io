<?xml version="1.0" encoding="UTF-8"?>
<includes>
	
	<include name="CommonBackground">
		
		<!-- VISUALIZATION -->
		<control type="visualisation">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<visible>!Player.HasVideo + Player.HasAudio + !Skin.HasSetting(ShowBackgroundVis) + !Slideshow.IsActive + !String.IsEmpty(Visualisation.Name)</visible>
			<visible>String.IsEmpty(Window(Videos).Property(PlayingBackgroundMedia))</visible>
		</control>
		
		
		<!-- MakeTransparentForVisualization Replacement START -->
		<control type="group">
			
			<!-- DEFAULT /backgrounds/background_XX BACKGROUND -->
			<control type="image">
				<depth>DepthBackground</depth>
				<description>Default Backgrounds</description>
				<include>BackgroundDimensions</include>
				<aspectratio>scale</aspectratio>
				<texture>$VAR[DefaultBackgroundX]</texture>
				<visible>[ ![[!Player.HasVideo + Player.HasAudio + !Skin.HasSetting(ShowBackgroundVis) + !Slideshow.IsActive + !String.IsEmpty(Visualisation.Name)] + String.IsEmpty(Window(Videos).Property(PlayingBackgroundMedia))] | !Control.IsVisible(234237)] + 
								![
								[String.IsEqual(Skin.String(UseCustomBackground),1) + !String.IsEmpty(Skin.String(CustomBackgroundPath))] | 
								[String.IsEqual(Skin.String(UseCustomBackground),2) + !String.IsEmpty(Skin.String(CustomBackgroundPathMultiple))]
								] 
								+ !String.IsEqual(Skin.String(BackgroundType),99)
			</visible>
				<include>VisibleFadeEffect</include>
			</control>
			
			<!-- HEXAGONS SPECIAL -->
			<include condition="String.IsEqual(Skin.String(BackgroundType),99) + [String.IsEqual(Skin.String(UseCustomBackground),0) | String.IsEmpty(Skin.String(UseCustomBackground))]">BackgroundHexagons</include>
			
			<!-- CUSTOM BACKGROUND - Single Image -->
			<control type="image">
				<depth>DepthBackground</depth>
				<description>User Set Background Image</description>
				<include>BackgroundDimensions</include>
				<aspectratio>scale</aspectratio>
				<texture>$INFO[Skin.String(CustomBackgroundPath)]</texture>
				<visible>[ ![[!Player.HasVideo + Player.HasAudio + !Skin.HasSetting(ShowBackgroundVis) + !Slideshow.IsActive + !String.IsEmpty(Visualisation.Name)] + String.IsEmpty(Window(Videos).Property(PlayingBackgroundMedia))] | !Control.IsVisible(234237)] + 
				String.IsEqual(Skin.String(UseCustomBackground),1) + !String.IsEmpty(Skin.String(CustomBackgroundPath))</visible>
				<include>VisibleFadeEffect</include>
			</control>
			
			<!-- CUSTOM BACKGROUND - Multiple Images -->
			<control type="multiimage">
				<include>BackgroundDimensions</include>
				<imagepath background="true">$INFO[Skin.String(CustomBackgroundPathMultiple)]</imagepath>
				<aspectratio>scale</aspectratio>
				
				<include condition="String.IsEqual(Skin.String(CustomBackgroundMultipleTimePerImage),0)">CustomBackgroundMultipleTimePerImage_Include_0</include>
				<include condition="String.IsEqual(Skin.String(CustomBackgroundMultipleTimePerImage),1) | String.IsEmpty(Skin.String(CustomBackgroundMultipleTimePerImage))">CustomBackgroundMultipleTimePerImage_Include_1</include>
				<include condition="String.IsEqual(Skin.String(CustomBackgroundMultipleTimePerImage),2)">CustomBackgroundMultipleTimePerImage_Include_2</include>
				<include condition="String.IsEqual(Skin.String(CustomBackgroundMultipleTimePerImage),3)">CustomBackgroundMultipleTimePerImage_Include_3</include>
				<include condition="String.IsEqual(Skin.String(CustomBackgroundMultipleTimePerImage),4)">CustomBackgroundMultipleTimePerImage_Include_4</include>
				<include condition="String.IsEqual(Skin.String(CustomBackgroundMultipleTimePerImage),5)">CustomBackgroundMultipleTimePerImage_Include_5</include>
				<include condition="String.IsEqual(Skin.String(CustomBackgroundMultipleTimePerImage),6)">CustomBackgroundMultipleTimePerImage_Include_6</include>
				
				<randomize>true</randomize>
				<fadetime>2500</fadetime>
				
				<visible>[ ![[!Player.HasVideo + Player.HasAudio + !Skin.HasSetting(ShowBackgroundVis) + !Slideshow.IsActive + !String.IsEmpty(Visualisation.Name)] + String.IsEmpty(Window(Videos).Property(PlayingBackgroundMedia))] | !Control.IsVisible(234237)] + 
								String.IsEqual(Skin.String(UseCustomBackground),2) + !String.IsEmpty(Skin.String(CustomBackgroundPathMultiple)) 
								+ !Slideshow.IsActive 
								+ ![Player.HasVideo + !Skin.HasSetting(ShowBackgroundVideo)]</visible>
				
			</control>
			
			<!-- FANART -->
			<!-- fanart check var -->
			<control type="label" id="234235">
				<label>$VAR[MediaFanartVar]</label>
				<visible>false</visible>
			</control>
			<control type="image" id="234237">
				<depth>DepthBackground</depth>
				<include>BackgroundDimensions</include>
				<aspectratio>scale</aspectratio>
				<texture background="true">$VAR[MediaFanartVar]</texture>
				
				<include>backgroundfade</include>
				<fadetime>FanartCrossfadeTime</fadetime>
				<visible>
				[!Control.IsVisible(508) + 
				[[!Control.IsVisible(500) + !Control.IsVisible(908) + !Control.IsVisible(909) + !Control.IsVisible(910) + !Control.IsVisible(911)] | [[Control.IsVisible(500) | Control.IsVisible(908) | Control.IsVisible(909) | Control.IsVisible(910)] + [String.IsEqual(Container.Content,Albums) | String.IsEqual(Container.Content,Artists) | [Player.HasAudio + [!String.IsEmpty(Player.Art(album.fanart)) | !String.IsEmpty(Player.Art(fanart))]]]]]] 
								+ [!Skin.HasSetting(HideBackGroundFanart) + !String.IsEmpty(Control.GetLabel(234235))] 
								+ ![Player.HasVideo + !Skin.HasSetting(ShowBackgroundVideo)]</visible>
				
			</control>
			
			
			
			<!-- MakeTransparentForVisualization Replacement END -->
			<animation effect="fade" start="100" end="50" time="0" condition="[!Player.HasVideo + Player.HasAudio + !Skin.HasSetting(ShowBackgroundVis) + !Slideshow.IsActive + !String.IsEmpty(Visualisation.Name)] + String.IsEmpty(Window(Videos).Property(PlayingBackgroundMedia))">Conditional</animation>
		</control>
		
		
		
		<!-- black out everything behind playing video or playing audio-vis -->
		<control type="image">
			<include>BackgroundDimensions</include>
			<texture>colors/black.png</texture>
			<visible>[Player.HasVideo + !Skin.HasSetting(ShowBackgroundVideo)] + String.IsEmpty(Window(Videos).Property(PlayingBackgroundMedia))</visible>
		</control>
		
		<!-- VIDEO -->
		<!-- default 16:9 variant -->
		<control type="videowindow">
			<depth>DepthBackground</depth>
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<visible>Player.HasVideo + !Skin.HasSetting(ShowBackgroundVideo) + !Slideshow.IsActive</visible>
		</control>
		
		
		<!-- GAME -->
		<control type="image">
			<include>BackgroundDimensions</include>
			<texture>special://home/addons/resource.images.aczg/resources/backgrounds/$VAR[isUhdScreenStringFolder]fullscreengame.png</texture>
			<visible>Player.HasGame</visible>
		</control>
		
		
	</include>
	
	<include name="ContentPanelBackgrounds">
		
		<control type="group">
			
			<control type="group">
				
				<!-- semi-transparent IF VIDEO OR VIS SHOWING -->
				<control type="image" id="9999991">
					<left>-1</left>
					<top>-1</top>
					<width>1922</width>
					<height>1082</height>
					<texture background="true">colors/black.png</texture>
					
					<visible>!Player.HasGame + Player.HasVideo + !Skin.HasSetting(ShowBackgroundVideo)</visible>
					<!-- Kodi 18+ !Player.HasGame -->
					<animation effect="fade" end="88" time="0" condition="true">Conditional</animation>
					
				</control>
				
				
				
				<!-- semi-transparent IF NO MOVING BACKGROUND -->
				<control type="group">
					<control type="image" id="9999992">
						<left>-1</left>
						<top>-1</top>
						<width>1922</width>
						<height>1082</height>
						<texture>colors/black.png</texture>
						
						<visible>!Control.IsVisible(9999991)</visible>
						
						<animation effect="fade" end="75" time="1500" condition="true">Conditional</animation>
						
					</control>
					
					<animation effect="fade" start="100"   end="0" time="1000" condition="Window.IsActive(SkinSettings) + !Skin.HasSetting(BackgroundsAutoPreviewOnSelectDisable) 
						+ [Control.HasFocus(400) | Control.HasFocus(396) | Control.HasFocus(398) | Control.HasFocus(397) | Control.HasFocus(311) | Control.HasFocus(312) | Control.HasFocus(314) | Control.HasFocus(316) | Control.HasFocus(313)] 
						+ String.IsEqual(Skin.String(BackgroundDarkenStrength),0)">Conditional</animation>
					
					
					<animation effect="fade" start="100"  end="24" time="1000" condition="Window.IsActive(SkinSettings) + !Skin.HasSetting(BackgroundsAutoPreviewOnSelectDisable) 
						+ [Control.HasFocus(400) | Control.HasFocus(396) | Control.HasFocus(398) | Control.HasFocus(397) | Control.HasFocus(311) | Control.HasFocus(312) | Control.HasFocus(314) | Control.HasFocus(316) | Control.HasFocus(313)] 
						+ String.IsEqual(Skin.String(BackgroundDarkenStrength),4)">Conditional</animation>
					<animation effect="fade" start="100"  end="42" time="1000" condition="Window.IsActive(SkinSettings) + !Skin.HasSetting(BackgroundsAutoPreviewOnSelectDisable) 
						+ [Control.HasFocus(400) | Control.HasFocus(396) | Control.HasFocus(398) | Control.HasFocus(397) | Control.HasFocus(311) | Control.HasFocus(312) | Control.HasFocus(314) | Control.HasFocus(316) | Control.HasFocus(313)] 
						+ String.IsEqual(Skin.String(BackgroundDarkenStrength),5)">Conditional</animation>
					
					
					<animation effect="fade" start="100"  end="67" time="1000" condition="Window.IsActive(SkinSettings) + !Skin.HasSetting(BackgroundsAutoPreviewOnSelectDisable) 
						+ [Control.HasFocus(400) | Control.HasFocus(396) | Control.HasFocus(398) | Control.HasFocus(397) | Control.HasFocus(311) | Control.HasFocus(312) | Control.HasFocus(314) | Control.HasFocus(316) | Control.HasFocus(313)] 
						+ [String.IsEmpty(Skin.String(BackgroundDarkenStrength)) | String.IsEqual(Skin.String(BackgroundDarkenStrength),1)]">Conditional</animation>
					<animation effect="fade" start="100"  end="83" time="1000" condition="Window.IsActive(SkinSettings) + !Skin.HasSetting(BackgroundsAutoPreviewOnSelectDisable) 
						+ [Control.HasFocus(400) | Control.HasFocus(396) | Control.HasFocus(398) | Control.HasFocus(397) | Control.HasFocus(311) | Control.HasFocus(312) | Control.HasFocus(314) | Control.HasFocus(316) | Control.HasFocus(313)] 
						+ String.IsEqual(Skin.String(BackgroundDarkenStrength),2)">Conditional</animation>
					<animation effect="fade" start="100" end="100" time="1000" condition="Window.IsActive(SkinSettings) + !Skin.HasSetting(BackgroundsAutoPreviewOnSelectDisable) 
						+ [Control.HasFocus(400) | Control.HasFocus(396) | Control.HasFocus(398) | Control.HasFocus(397) | Control.HasFocus(311) | Control.HasFocus(312) | Control.HasFocus(314) | Control.HasFocus(316) | Control.HasFocus(313)] 
						+ String.IsEqual(Skin.String(BackgroundDarkenStrength),3)">Conditional</animation>
					
				</control>
				
				
				
			</control>
			
		</control>
		
	</include>
	
</includes>
