<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="1181">
	<zorder>2</zorder>
	
	<animation effect="fade" start="100" end="100" time="0">WindowOpen</animation>
	<animation effect="fade" start="100" end="0" tween="quadratic" easing="in" time="5000">WindowClose</animation>
	
	<visible>Window.IsVisible(1180)</visible>
	
	<onload condition="String.IsEqual(Skin.String(StartScreenDelay),0) | String.IsEmpty(Skin.String(StartScreenDelay))">AlarmClock(ExperimentalStartScreenAlarm1,SetProperty(ExperimentalStartScreenDone,True,home),00:00:01,true)</onload>
	<onload condition="String.IsEqual(Skin.String(StartScreenDelay),1)">AlarmClock(ExperimentalStartScreenAlarm1,SetProperty(ExperimentalStartScreenDone,True,home),00:00:02,true)</onload>
	<onload condition="String.IsEqual(Skin.String(StartScreenDelay),2)">AlarmClock(ExperimentalStartScreenAlarm1,SetProperty(ExperimentalStartScreenDone,True,home),00:00:03,true)</onload>
	<onload condition="String.IsEqual(Skin.String(StartScreenDelay),3)">AlarmClock(ExperimentalStartScreenAlarm1,SetProperty(ExperimentalStartScreenDone,True,home),00:00:04,true)</onload>
	<onload condition="String.IsEqual(Skin.String(StartScreenDelay),4)">AlarmClock(ExperimentalStartScreenAlarm1,SetProperty(ExperimentalStartScreenDone,True,home),00:00:07,true)</onload>
	<onload condition="String.IsEqual(Skin.String(StartScreenDelay),5)">AlarmClock(ExperimentalStartScreenAlarm1,SetProperty(ExperimentalStartScreenDone,True,home),00:00:10,true)</onload>
	<onunload>AlarmClock(ExperimentalStartScreenAlarm2,SetProperty(ExperimentalStartScreenDoneDelayed,True,home),00:00:25,true)</onunload>
	
	
	<controls><!-- WRAPPER START --><control type="group"><centerleft>50%</centerleft><centertop>50%</centertop><width>1920</width><height>1080</height><!-- WRAPPER START -->
		
		
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture>colors/black.png</texture>
		</control>
		
		<control type="image">
			<left>906</left>
			<top>486</top>
			<width>108</width>
			<height>108</height>
			<texture colordiffuse="$VAR[uiColorVariantKodiLogoColorFadeInScreen]">_added_img/$VAR[LogoScreenLogoTypeVarFilenameTranslate]</texture>
			<animation effect="fade" start="0" end="100" time="1000">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="250">WindowClose</animation>
			<aspectratio>keep</aspectratio>
			
			<animation effect="slide" end="0,-42" time="0" condition="String.IsEqual(Skin.String(LogoScreenLogoType),2)">Conditional</animation>
			
			<visible>!String.IsEqual(Skin.String(LogoScreenLogoType),3)</visible>
		</control>
		
		<control type="image">
			<left>867</left>
			<top>591</top>
			<width>186</width>
			<height>48</height>
			<texture>_added_img/madvr-logo-full$VAR[isUhdScreenStringSuffix].png</texture>
			<aspectratio>keep</aspectratio>
			
			<animation effect="fade" start="0" end="100" time="1000" delay="1000">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="250">WindowClose</animation>
			
			<visible>!String.IsEqual(Skin.String(LogoScreenLogoType),3) + String.IsEqual(Skin.String(LogoScreenLogoType),2)</visible>
		</control>
		
	<include condition="Skin.HasSetting(EnableDebugOverlaySkinAndVars)">DebugOverlaySkinAndVars</include><include condition="Skin.HasSetting(EnableDebugOverlaySystemLoad)">DebugOverlaySystemLoad</include><!-- WRAPPER STOP --></control><!-- WRAPPER STOP --></controls>
</window>
