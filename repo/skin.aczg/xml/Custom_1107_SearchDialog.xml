				<content>
					<item>
						<label>$LOCALIZE[1212] $LOCALIZE[14022]</label>
						<label2>Search Video Library</label2>
						<icon>header_icons/icon_videos.png</icon>
						
						<onclick>SetProperty(SearchOpenedFromHome,true,home)</onclick>
						<onclick>Dialog.Close(all)</onclick>
						<onclick>ActivateWindow(Videos,return)</onclick>
						<onclick>VideoLibrary.Search</onclick>
						
						<visible>Library.HasContent(Movies) | Library.HasContent(TvShows)</visible>
					</item>
					<item>
						<label>$LOCALIZE[1211] $LOCALIZE[14022]</label>
						<label2>Search Music Library</label2>
						<icon>header_icons/icon_music.png</icon>
						
						<onclick>SetProperty(SearchOpenedFromHome,true,home)</onclick>
						<onclick>Dialog.Close(all)</onclick>
						<onclick>ActivateWindow(Music,return)</onclick>
						<onclick>SendClick(10502,8)</onclick>
						
						<visible>Library.HasContent(Music)</visible>
					</item>
					<item>
						<label>YouTube</label>
						<label2>Search YouTube</label2>
						<icon>_added_img/search/youtube$VAR[isUhdScreenStringSuffix].png</icon>
						
						<onclick>Dialog.Close(all)</onclick>
						<onclick condition="!System.HasAddon(plugin.video.youtube)">InstallAddon(plugin.video.youtube)</onclick>
						<onclick condition="System.HasAddon(plugin.video.youtube)">ActivateWindow(Videos,plugin://plugin.video.youtube/kodion/search/list/,return)</onclick>
					</item>
					<item>
						<label>The Movie DB</label>
						<label2>Search TheMovieDb</label2>
						<icon>_added_img/search/tmdb$VAR[isUhdScreenStringSuffix].png</icon>
						
						<onclick>Dialog.Close(all)</onclick>
						<onclick condition="!System.HasAddon(script.extendedinfo)">InstallAddon(script.extendedinfo)</onclick>
						
						
						<!-- Kodi 19+ AddonIsEnabled check -->
						<onclick condition="![String.StartsWith(System.BuildVersion,17.) | String.StartsWith(System.BuildVersion,18.)] + !System.AddonIsEnabled(script.extendedinfo)">EnableAddon(script.extendedinfo)</onclick>
						
						
						<onclick condition="System.HasAddon(script.extendedinfo)">RunScript(script.extendedinfo,info=moviedbbrowser,search=True)</onclick>
					</item>
					<item>
						<label>Netflix</label>
						<label2>Search Netflix</label2>
						<icon>_added_img/search/netflix$VAR[isUhdScreenStringSuffix].png</icon>
						
						<onclick>Dialog.Close(all)</onclick>
						<onclick>ActivateWindow(10025,plugin://plugin.video.netflix/directory/search/search/,return)</onclick>
						
						<visible>System.HasAddon(plugin.video.netflix)</visible>
					</item>
					<item>
						<label>Prime Video</label>
						<label2>Search Prime Video</label2>
						<icon>_added_img/search/prime_video$VAR[isUhdScreenStringSuffix].png</icon>
						
						<onclick>Dialog.Close(all)</onclick>
						
						<onclick>ActivateWindow(10025,plugin://plugin.video.amazon-test/pv/search/,return)</onclick>
						
						<visible>System.HasAddon(plugin.video.amazon-test)</visible>
					</item>
					<item>
						<label>$LOCALIZE[24001]</label>
						<label2>Search Add-ons</label2>
						<icon>header_icons/icon_addons.png</icon>
						
						<onclick>SetProperty(SearchOpenedFromHome,true,home)</onclick>
						<onclick>Dialog.Close(all)</onclick>
						<onclick>ActivateWindow(AddonBrowser,addons://search/)</onclick>
					</item>
					
					
					
					<item>
						<label>Global Search</label>
						<label2>Search Global Search</label2>
						<icon>_added_img/search/script.globalsearch.png</icon>
						
						<onclick>Dialog.Close(all)</onclick>
						<onclick>RunScript(script.globalsearch)</onclick>
						
						<visible>System.HasAddon(script.globalsearch)</visible>
					</item>
					
					
					
					<item>
						<label>$LOCALIZE[19020]  EPG</label>
						<label2>Search TV</label2>
						<icon>header_icons/icon_pvr.png</icon>
						
						<onclick condition="Pvr.HasTVChannels">Dialog.Close(all)</onclick>
						<onclick condition="Pvr.HasTVChannels">ActivateWindow(TVSearch)</onclick>
						
						<property name="pvrtv">true</property>
						
						<visible>System.HasPVRAddon</visible>
						<include>PVRTVNoChannelsOnClickNotify</include>
					</item>
					<item>
						<label>$LOCALIZE[19021]  EPG</label>
						<label2>Search Radio</label2>
						<icon>header_icons/icon_pvr_radio.png</icon>
						
						<onclick condition="Pvr.HasRadioChannels">Dialog.Close(all)</onclick>
						<onclick condition="Pvr.HasRadioChannels">ActivateWindow(RadioSearch)</onclick>
						
						<property name="pvrradio">true</property>
						
						<visible>System.HasPVRAddon</visible>
						<include>PVRRadioNoChannelsOnClickNotify</include>
					</item>
					
					
					
